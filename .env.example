# ── Supabase (project: nwrmggfejaxjryhdrhqb — "thescaleup") ──────────────────
# Server-side lead storage for /api/lead. The service role key is a SECRET:
# it must only ever live in server env (never NEXT_PUBLIC_, never committed).
SUPABASE_URL=https://nwrmggfejaxjryhdrhqb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional — for future client-side Supabase usage (safe to expose):
NEXT_PUBLIC_SUPABASE_URL=https://nwrmggfejaxjryhdrhqb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Brand app (/hub): sign-in codes and invitations are sent with Resend.
# MAIL_FROM must be a sender on a domain verified in Resend. HUB_BASE_URL is used in invite links (defaults to https://thescaleup.xyz).
RESEND_API_KEY=
MAIL_FROM="ScaleUp <noreply@thescaleup.xyz>"
HUB_BASE_URL=

# Mail (/hub/b/<brand>/mail): Resend signs inbound/delivery webhooks (Svix). Create the webhook in Resend
# pointing to https://<host>/api/mail/resend, then paste its signing secret (whsec_...) here.
RESEND_WEBHOOK_SECRET=

# Mail attachments: files are kept in a private Cloudflare R2 bucket and uploaded straight from the browser with presigned links.
# R2 → Manage API tokens → S3 credentials (Object Read & Write on this bucket). The bucket needs a CORS rule allowing PUT from the app's origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=thescaleup-assets
